# ---------------------------------------------------------------------------
# Template — terraform/prod.tfvars. COMMITTED TO GIT, on purpose.
#
# The single source of truth for NON-secret settings, used by local runs and CI so that
# the two never silently diverge.
#   DO NOT put passwords, tokens, private keys, or any credentials here.
#   Secrets: local → terraform.tfvars (gitignored); CI → GitHub Secrets as TF_VAR_<name>;
#   application → SSM Parameter Store (see app_secret_keys below).
# Usage: terraform plan -var-file=prod.tfvars
#
# Case study "AWS + Supabase + Cloudflare" (pakem: case-studies/aws-supabase-cloudflare): an illustration, not part
# of the pakem standard. Every value below is that deployment's choice.
# ---------------------------------------------------------------------------

# ---- Global ----
# This project's dedicated account. The provider uses it as allowed_account_ids:
# apply fails fast if the active credentials point at another account.
aws_account_id = "<12-digit-account-id>"
aws_region     = "<region>"
project        = "<project>"
environment    = "prod"

# ---- Networking ----
vpc_cidr             = "10.0.0.0/16"
azs                  = ["<region>a", "<region>b"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]

# ---- Compute ----
ecs_instance_type        = "m6g.large"
ecs_asg_min_size         = 1
ecs_asg_desired_capacity = 1
ecs_asg_max_size         = 3

typesense_instance_type    = "t4g.small"
typesense_data_volume_size = 20

# ---- ECS services ----
# API and worker share ONE image from ONE ECR repo; only the command differs.
# Image ENTRYPOINT = binary, CMD ["main"]. The ECS `command` overrides CMD, not ENTRYPOINT,
# so the subcommand alone is enough.
#   main   -> HTTP server
#   worker -> ALL workers in one process
app_image_tag  = "latest"
api_command    = ["main"]
worker_command = ["worker"]

api_desired_count  = 1
api_min_capacity   = 1
api_max_capacity   = 4
api_cpu_target     = 70
api_container_port = 8000      # MUST match the application PORT and EXPOSE in the Dockerfile
health_check_path  = "/health"

# ---- Load balancer / TLS ----
# Cloudflare Origin Certificate (<domain> + *.<domain>), imported manually into ACM in this region.
# ACM does NOT renew imported certificates automatically; record the expiry date.
alb_certificate_arn = "<acm-certificate-arn>"

# ---- DNS / Cloudflare / SES ----
domain_name        = "<domain>"
app_subdomain      = "api"
cloudflare_zone_id = "<zone-id>"
dmarc_rua          = ""

# ---------------------------------------------------------------------------
# APPLICATION CONFIGURATION — API and worker receive the SAME set (assembled once in modules/compute/ecs.tf).
# Precedence: the image ships an empty .env; godotenv does not override env that is already set, so the values here win.
# ---------------------------------------------------------------------------
ssm_parameter_prefix = "/<project>/prod"

app_environment = {
  # NOTE: godotenv checks whether a key EXISTS, not its value. KEY = "" overrides .env with an empty string.
  # A key that has no value yet is COMMENTED OUT, not left empty.
  # Booleans are written exactly "true"/"false" (strconv.ParseBool; any other value is read as the default).

  ENVIRONMENT = "production"
  PORT        = "8000"

  # ---- Redis (outside the stack) ----
  REDIS_ADDR = "<host>:<port>"

  # ---- Postgres (Supabase, outside the stack) ----
  # This VPC is IPv4-only: use the POOLER hostname (it has an A record), not the direct host (AAAA only).
  # The pooler USERNAME starts with the project ref (the pooler uses it for routing).
  # 6543 = transaction pooler, which MUST go together with POSTGRES_BINARY_PARAMETERS = "true".
  # Migrations, psql, pg_dump, CREATE INDEX CONCURRENTLY still go through 5432 (session).
  POSTGRES_WRITE_HOST        = "<pooler-host>"
  POSTGRES_WRITE_PORT        = "6543"
  POSTGRES_WRITE_USERNAME    = "<user>.<project-ref>"
  POSTGRES_WRITE_DBNAME      = "<db>"
  POSTGRES_READ_HOST         = "<pooler-host>"
  POSTGRES_READ_PORT         = "6543"
  POSTGRES_READ_USERNAME     = "<user>.<project-ref>"
  POSTGRES_READ_DBNAME       = "<db>"
  POSTGRES_BINARY_PARAMETERS = "true"
  POSTGRES_SSLMODE           = "require"
  # N × (write + read [+ library pool]) ≤ the pooler's Max Client Connections; N = 2 × api_max_capacity + 1.
  POSTGRES_WRITE_MAX_OPEN_CONNS = "10"
  POSTGRES_READ_MAX_OPEN_CONNS  = "10"

  # ---- Cloudflare R2 ----
  R2_ENDPOINT           = "https://<account-id>.r2.cloudflarestorage.com"
  R2_REGION             = "auto"
  R2_BUCKET             = "<public-bucket>"
  R2_PRIVATE_BUCKET     = "<private-bucket>"
  ASSET_PUBLIC_BASE_URL = "https://cdn.<domain>"   # including https://

  # ---- Email (SES through the SDK + task role; no SMTP, no access key) ----
  SES_FROM_ADDRESS = "no-reply@<domain>"
  SES_FROM_NAME    = "<Product>"
  SES_REGION       = "<region>"   # MUST match var ses_sending_region (the ARN in the task role policy)

  # ---- Feature / channel switches ----
  # Every switch: meaning, default in code, when & with whose approval it is changed, prerequisites, how to roll back.
  # WIDGET_ENABLED = "true"
  REDIFU_READS = "true"   # "false" = every read goes to SQL (cache emergency switch); the queue is still drained
}

# ---- Secrets: NAMES ONLY. Values in SSM <ssm_parameter_prefix>/<NAME>, pulled by the ECS agent at start. ----
# Fill them with scripts/put-secrets.sh <env-file>, BEFORE this change reaches main
# (a task that references a parameter that does not exist yet fails to start). Values > 1 KB are filled from a file.
app_secret_keys = [
  "REDIS_PASSWORD",
  "POSTGRES_WRITE_PASSWORD",
  "POSTGRES_READ_PASSWORD",
  "CLOUDFLARE_ACCESS_KEY_ID",
  "CLOUDFLARE_SECRET_ACCESS_KEY",
  "JWT_API_SECRET",
]
